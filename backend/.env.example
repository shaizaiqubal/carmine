SUPABASE_URL=
SUPABASE_ANON_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=data/carmine.db
CORS_ORIGINS=http://localhost:5173
LLM_CONFIG_PATH=app/llm/config.toml
LLM_CACHE_TTL_SECONDS=86400
LLM_MAX_ATTEMPTS=3
LLM_MAX_OVERLOAD_RETRIES=2
LLM_MAX_TOTAL_WAIT_SECONDS=20
LLM_CIRCUIT_FAILURE_COUNT=2
LLM_CIRCUIT_COOLDOWN_SECONDS=60
LLM_DEBUG_LOCAL=false
CARMINE_ENV=development
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional route overrides, comma-separated provider:model pairs.
# Example: LLM_ROUTE_VERIFY=groq:openai/gpt-oss-120b,gemini:gemma-4-31b-it
